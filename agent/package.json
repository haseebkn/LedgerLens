{
  "name": "financial-context-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node/TypeScript agent service — tool-using Claude agent over the financial context warehouse.",
  "exports": {
    "./streaming-types": {
      "types": "./src/streaming-types.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc -p tsconfig.build.json && node -e \"import('node:fs').then(fs=>fs.cpSync('src/db/migrations','dist/db/migrations',{recursive:true}))\"",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "eval": "tsx --env-file-if-exists=.env evals/run.ts",
    "eval:pr": "tsx --env-file-if-exists=.env evals/run.ts --subset 12 --gate",
    "eval:advisor": "tsx --env-file-if-exists=.env evals/run.ts --suite advisor --gate",
    "eval:advisor:safety": "tsx --env-file-if-exists=.env evals/run.ts --suite advisor --category tenant_isolation,prompt_injection,refusal --gate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@duckdb/node-api": "1.4.1-r.5",
    "@hono/node-server": "^2.1.11",
    "aws-jwt-verify": "5.2.1",
    "hono": "^4.13.23",
    "node-sql-parser": "^5.3.6",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=22"
  }
}
