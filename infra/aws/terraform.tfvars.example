aws_region   = "us-east-1"
project_name = "financial-context"
environment  = "prod"

# Optional custom domain. Leave empty to use CloudFront's built-in free
# https://<id>.cloudfront.net URL (no domain purchase or ACM cert needed).
domain_name     = ""
route53_zone_id = ""

# Optional: set to your GitHub repo to auto-create the least-privilege OIDC
# deploy role for .github/workflows/deploy.yml.
github_repo                 = "haseebkn/LedgerLens"
create_github_oidc_provider = false

# No secrets here: store ANTHROPIC_API_KEY and DEMO_PASSWORD in SSM Parameter
# Store (Always Free Standard SecureStrings) via AWS CLI after `terraform apply`.
